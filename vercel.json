{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/catalog",
      "destination": "/api/catalog.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}